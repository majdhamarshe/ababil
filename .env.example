# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://127.0.0.1:5173,http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/ababil
JWT_SECRET=change_this_to_a_long_random_secret_with_at_least_32_characters
JWT_EXPIRES_IN=7d

# Durable image uploads for production (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Used once with: npm run seed:admin
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=change-this-strong-password

# Frontend (Vite reads variables prefixed with VITE_)
VITE_API_URL=http://127.0.0.1:5000/api
